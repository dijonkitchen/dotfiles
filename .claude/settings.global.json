{
  "permissions": {
    "allow": [
      "mcp__atlassian__getJiraIssue"
    ],
    "defaultMode": "auto"
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false
  },
  "theme": "auto",
  "editorMode": "normal",
  "autoCompactEnabled": true
}
